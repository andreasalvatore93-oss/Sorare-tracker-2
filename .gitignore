__pycache__/
*.pyc
*.pyo

# Dati consolidati per tuning: rigenerabili con `python consolida_dati_globali.py`
/dati_globali/*
!/dati_globali/manifest.json

# Cache giornaliera L5/L10/L40 del generatore formazioni (rigenerabile via API Sorare)
/generatore_formazioni/.quality_cache/

# Cartelle di lavoro del passaggio dati tra job via artifact
# (pipeline_artifacts.py): esistono solo dentro i runner di Actions
/_artifact_stage/
/_artifacts/
/_costi_parziali/
/misure_costi.tsv
/_matrici/
/cfg.txt
/out.txt
/combos.tsv
/coppie.tsv

# Dump diagnostici GraphQL (richiesta+risposta integrale di OGNI chiamata):
# vengono riscritti a ogni run e nessuno script li rilegge -- servono solo a
# ispezionare la run in corso. Erano committati e pesavano 654 MB in 61.746
# file, cioe' il 54% dell'intero albero di lavoro da 1,2 GB: e' quello che i
# ~86 job di ogni run copiavano nei loro 13,3s di checkout a testa.
**/output/**/.debug/
# Uscite dei backtest lanciati a mano dalla radice (rigenerabili con
# backtest_arene*.py): nessuna e' mai stata committata, restavano solo a
# sporcare git status
/backtest_*.csv
/backtest_*.html

# Copia di sicurezza fatta a mano prima di un intervento sul difensore
/.pilot_backup_def/

.env.local
!dati_globali/arene_storico.json
!dati_globali/arene_storico_full.json
!dati_globali/arene_storico_full_v2.json
!dati_globali/classifiche_arene_2026-08-08.json
!dati_globali/classifiche_arene_2026-08-08_falliti.json
!dati_globali/premi_arene_2026-08-08.json
!dati_globali/premi_arene_2026-08-08_falliti.json
!dati_globali/arene_formazioni.json
# Filone smart money (§7): input workflow + formazioni reali dei manager
# (i punteggi realizzati servono per la misura residuo, vanno versionati).
!dati_globali/smart_money/
!dati_globali/smart_money/**
!dati_globali/manager_*.json
# Filone favorito_odds (05-06/08): indice quote 1X2 e mappa fixture->data,
# non banalmente rigenerabili senza rifare le estrazioni bulk della sessione.
!dati_globali/odds_1x2_index.json
!dati_globali/fixture_date_map.json
pool_gw.json
_ultimo_report.txt
