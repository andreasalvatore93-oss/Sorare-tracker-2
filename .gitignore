__pycache__/
*.pyc
*.pyo

# Dati consolidati per tuning: rigenerabili con `python consolida_dati_globali.py`
/dati_globali/*
!/dati_globali/manifest.json

# Cache giornaliera L5/L10/L40 del generatore formazioni (rigenerabile via API Sorare)
/generatore_formazioni/.quality_cache/

# Cartelle di lavoro del passaggio dati tra job via artifact
# (pipeline_artifacts.py): esistono solo dentro i runner di Actions
/_artifact_stage/
/_artifacts/
/_costi_parziali/
/misure_costi.tsv
/_matrici/
/cfg.txt
/out.txt
/combos.tsv
/coppie.tsv

# Dump diagnostici GraphQL (richiesta+risposta integrale di OGNI chiamata):
# vengono riscritti a ogni run e nessuno script li rilegge -- servono solo a
# ispezionare la run in corso. Erano committati e pesavano 654 MB in 61.746
# file, cioe' il 54% dell'intero albero di lavoro da 1,2 GB: e' quello che i
# ~86 job di ogni run copiavano nei loro 13,3s di checkout a testa.
**/output/**/.debug/
